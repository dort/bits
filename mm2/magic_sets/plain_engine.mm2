; Full-closure reference mode. Same evaluator, with no magic restriction.
; Include common.mm2. Namespace original EDB/IDB predicates consistently.
(exec (0 facts) (, (fact $pred $values)) (, (ms (tuple (base $pred) $values))))
((step plainBodyq) (, (rule $id $head $body)) (, (next (renameq $body))))
((step rename0) (, (ms (renameq nil))) (, (next (rename nil nil))))
((step renameRest) (, (ms (renameq (cons $atom $tail)))) (, (next (renameq $tail))))
((step renameEDB) (, (ms (renameq (cons (atom $pred $args) $tail)))
                     (edb $pred) (ms (rename $tail $out)))
  (, (next (rename (cons (atom $pred $args) $tail) (cons (atom (base $pred) $args) $out)))))
((step renameIDB) (, (ms (renameq (cons (atom $pred $args) $tail)))
                     (idb $pred) (ms (rename $tail $out)))
  (, (next (rename (cons (atom $pred $args) $tail) (cons (atom (plain $pred) $args) $out)))))
((step plainRule) (, (rule $id (atom $pred $args) $body) (ms (rename $body $out)))
  (, (next (clause (original $id) (atom (plain $pred) $args) $out))))
((step plainQueryEDB) (, (query $id (atom $pred $args)) (edb $pred))
  (, (next (clause (query $id) (atom (answer $id $pred) $args)
                   (cons (atom (base $pred) $args) nil)))))
((step plainQueryIDB) (, (query $id (atom $pred $args)) (idb $pred))
  (, (next (clause (query $id) (atom (answer $id $pred) $args)
                   (cons (atom (plain $pred) $args) nil)))))
