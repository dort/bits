; Grammar gchn: the review's 31-production unit chain.
;   a00 -> a01 ; a01 -> a02 ; ... ; a29 -> a30 ; a30 -> INT
; On one INT token the default token-count budget heuristic is far
; too small: insufficient rounds are not a rejection proof.
(grm-start gchn a00)
(grm-prod gchn c00 a00 1)
(grm-rhs gchn c00 0 (nt a01))
(grm-prod gchn c01 a01 1)
(grm-rhs gchn c01 0 (nt a02))
(grm-prod gchn c02 a02 1)
(grm-rhs gchn c02 0 (nt a03))
(grm-prod gchn c03 a03 1)
(grm-rhs gchn c03 0 (nt a04))
(grm-prod gchn c04 a04 1)
(grm-rhs gchn c04 0 (nt a05))
(grm-prod gchn c05 a05 1)
(grm-rhs gchn c05 0 (nt a06))
(grm-prod gchn c06 a06 1)
(grm-rhs gchn c06 0 (nt a07))
(grm-prod gchn c07 a07 1)
(grm-rhs gchn c07 0 (nt a08))
(grm-prod gchn c08 a08 1)
(grm-rhs gchn c08 0 (nt a09))
(grm-prod gchn c09 a09 1)
(grm-rhs gchn c09 0 (nt a10))
(grm-prod gchn c10 a10 1)
(grm-rhs gchn c10 0 (nt a11))
(grm-prod gchn c11 a11 1)
(grm-rhs gchn c11 0 (nt a12))
(grm-prod gchn c12 a12 1)
(grm-rhs gchn c12 0 (nt a13))
(grm-prod gchn c13 a13 1)
(grm-rhs gchn c13 0 (nt a14))
(grm-prod gchn c14 a14 1)
(grm-rhs gchn c14 0 (nt a15))
(grm-prod gchn c15 a15 1)
(grm-rhs gchn c15 0 (nt a16))
(grm-prod gchn c16 a16 1)
(grm-rhs gchn c16 0 (nt a17))
(grm-prod gchn c17 a17 1)
(grm-rhs gchn c17 0 (nt a18))
(grm-prod gchn c18 a18 1)
(grm-rhs gchn c18 0 (nt a19))
(grm-prod gchn c19 a19 1)
(grm-rhs gchn c19 0 (nt a20))
(grm-prod gchn c20 a20 1)
(grm-rhs gchn c20 0 (nt a21))
(grm-prod gchn c21 a21 1)
(grm-rhs gchn c21 0 (nt a22))
(grm-prod gchn c22 a22 1)
(grm-rhs gchn c22 0 (nt a23))
(grm-prod gchn c23 a23 1)
(grm-rhs gchn c23 0 (nt a24))
(grm-prod gchn c24 a24 1)
(grm-rhs gchn c24 0 (nt a25))
(grm-prod gchn c25 a25 1)
(grm-rhs gchn c25 0 (nt a26))
(grm-prod gchn c26 a26 1)
(grm-rhs gchn c26 0 (nt a27))
(grm-prod gchn c27 a27 1)
(grm-rhs gchn c27 0 (nt a28))
(grm-prod gchn c28 a28 1)
(grm-rhs gchn c28 0 (nt a29))
(grm-prod gchn c29 a29 1)
(grm-rhs gchn c29 0 (nt a30))
(grm-prod gchn c30 a30 1)
(grm-rhs gchn c30 0 (t INT))
(grm-dot gchn 0 1)
