; Ground integer token streams: stream nK holds K INT tokens.
(lex-token ints n1 0 1 INT)
(lex-end ints n1 1 c1)
(lex-token ints n2 0 1 INT)
(lex-token ints n2 1 2 INT)
(lex-end ints n2 2 c2)
(lex-token ints n3 0 1 INT)
(lex-token ints n3 1 2 INT)
(lex-token ints n3 2 3 INT)
(lex-end ints n3 3 c3)
(lex-token ints n8 0 1 INT)
(lex-token ints n8 1 2 INT)
(lex-token ints n8 2 3 INT)
(lex-token ints n8 3 4 INT)
(lex-token ints n8 4 5 INT)
(lex-token ints n8 5 6 INT)
(lex-token ints n8 6 7 INT)
(lex-token ints n8 7 8 INT)
(lex-end ints n8 8 c8)
