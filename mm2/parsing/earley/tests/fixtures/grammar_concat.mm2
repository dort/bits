; Grammar gcat: expr -> expr expr | INT (ambiguous concatenation).
; Over N integer tokens the completed dot-2 parts of production cat number
; exactly the ordered boundary triples origin < split < end: C(N+1, 3).
(grm-start gcat expr)
(grm-prod gcat cat expr 2)
(grm-rhs gcat cat 0 (nt expr))
(grm-rhs gcat cat 1 (nt expr))
(grm-prod gcat int expr 1)
(grm-rhs gcat int 0 (t INT))
(grm-dot gcat 0 1)
(grm-dot gcat 1 2)
