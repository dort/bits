; Tests for UNSIMPLIFIED differentiation results (plain engine only):
;   ./run.sh test.mm2
; Expected output: one (CORRECT EXPR) per case and no MISTAKE facts.
;
; Inputs are the typed AST; the AST is self-describing, so there are no
; (dvar _) / (const _) declarations.

; ---------------- test inputs ----------------
(diff (var x))
(solution (var x) (num 1))

(diff (num 7))
(solution (num 7) (num 0))

(diff (add (mul (var x) (var x)) (mul (num 2) (var x))))
(solution (add (mul (var x) (var x)) (mul (num 2) (var x)))
          (add (add (mul (num 1) (var x)) (mul (var x) (num 1)))
               (add (mul (num 0) (var x)) (mul (num 2) (num 1)))))

(diff (sin (mul (var x) (var x))))
(solution (sin (mul (var x) (var x)))
          (mul (cos (mul (var x) (var x)))
               (add (mul (num 1) (var x)) (mul (var x) (num 1)))))

(diff (div (var x) (add (var x) (cst a))))
(solution (div (var x) (add (var x) (cst a)))
          (div (sub (mul (num 1) (add (var x) (cst a)))
                    (mul (var x) (add (num 1) (num 0))))
               (mul (add (var x) (cst a)) (add (var x) (cst a)))))

(diff (mul (exp (neg (var x))) (ln (var x))))
(solution (mul (exp (neg (var x))) (ln (var x)))
          (add (mul (mul (exp (neg (var x))) (neg (num 1))) (ln (var x)))
               (mul (exp (neg (var x))) (div (num 1) (var x)))))

(diff (cos (sub (var x) (num 2))))
(solution (cos (sub (var x) (num 2)))
          (neg (mul (sin (sub (var x) (num 2))) (sub (num 1) (num 0)))))

(diff (pow (var x) (num 3)))
(solution (pow (var x) (num 3))
          (mul (mul (num 3) (pow (var x) (num 2))) (num 1)))

(diff (pow (add (var x) (cst a)) (num -2)))
(solution (pow (add (var x) (cst a)) (num -2))
          (mul (mul (num -2) (pow (add (var x) (cst a)) (num -3)))
               (add (num 1) (num 0))))

; floating leaf and constant floating exponent
(diff (flt 2.5))
(solution (flt 2.5) (num 0))

(diff (pow (var x) (flt 2.5)))
(solution (pow (var x) (flt 2.5))
          (mul (mul (flt 2.5) (pow (var x) (flt 1.5))) (num 1)))

; binary exp is the alternate constant-exponent spelling
(diff (exp (var x) (flt 2.5)))
(solution (exp (var x) (flt 2.5))
          (mul (num 1) (mul (flt 2.5) (exp (var x) (flt 1.5)))))

; ---------------- test code ----------------
; MISTAKE = (result U solution) \ (result /\ solution), per diff root.
(exec (zzt 0) (, (diff $e) (result $e $de)) (O (+ (MISTAKE $e $de))))
(exec (zzt 0) (, (diff $e) (solution $e $de)) (O (+ (MISTAKE $e $de))))
(exec (zzt 1) (, (result $e $de) (solution $e $de)) (O (- (MISTAKE $e $de))))
(exec (zzt 2) (, (diff $e)) (, (CORRECT $e)))
(exec (zzt 3) (, (MISTAKE $e $de)) (O (- (CORRECT $e))))
