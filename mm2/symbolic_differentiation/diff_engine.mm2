; =====================================================================
; Symbolic differentiation engine in MM2 — clean (typed-AST) representation
; =====================================================================
;
; Expressions are a strongly typed AST: every case has its own
; constructor, so every rule dispatches by pattern (unification) alone —
; no catch-all defaults, no classify-by-parse-failure ("clean" rather
; than "defaulty" representation, in the Prolog sense).
;
;   leaves:     (num N)   integer literal, N an i64 symbol
;               (flt F)   floating literal, F an f64 symbol
;               (var x)   THE variable of differentiation (one per
;                         program; its name is documentation)
;               (cst c)   any other symbolic leaf (parameters, other
;                         variables): derivative 0
;   compounds:  (add u v) (sub u v) (mul u v) (div u v)
;               (pow u (num N)|(flt F)) [constant numeric exponent]
;               (neg u) (sin u) (cos u) (exp u) (ln u)
;
; Input facts:  (diff EXPR)      any number of them; nothing else — the
;                                AST is self-describing, so the old
;                                (dvar _) / (const _) declarations and
;                                the parse-every-todo integer detector
;                                are gone.
; Output facts: (result EXPR D)  where D = dEXPR/dx, unsimplified
;                                (including operand order). The optional
;                                simplify.mm2 layer owns canonical form,
;                                including numbers-left add/mul; doing it
;                                here would duplicate value classification.
;
; Architecture (priorities order the phases by shortlex on the exec tag:
; (0 _) < (a0 _) < (az _) < (b0 _) < (c0 _) < (cz _) < (zz _)):
;
;   Setup    (0 _)   seed (todo Z EXPR) per diff root.
;   Phase A  (a_ _)  top-down decomposition. A self-recreating driver
;                    walks depth levels, instantiating the arule data,
;                    producing (todo (S l) child) and (sub E) per
;                    subterm, plus one (level l) fact per depth.
;   Bases    (b0 _)  base derivatives, each a one-shot exec dispatching
;                    on a leaf constructor: (num _) -> 0, (var _) -> 1,
;                    (cst _) -> 0. The only pure-sink call is the pow
;                    exponent decrement (expm1), real arithmetic whose
;                    argument the (num $n) pattern guarantees to parse.
;   Phase B  (c_ _)  bottom-up combination, one sweep of the brule data
;                    per (level l) fact.
;   Collect  (zz _)  copy root derivatives into (result EXPR D).

; ---------------------------------------------------------------------
; Setup
; ---------------------------------------------------------------------
(exec (0 root) (, (diff $e)) (, (todo Z $e)))

; ---------------------------------------------------------------------
; Phase A: decomposition rules, parameterized by level $l
; ---------------------------------------------------------------------
((arule add $l) (, (todo $l (add $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (add $u $v))))
((arule sub $l) (, (todo $l (sub $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (sub $u $v))))
((arule mul $l) (, (todo $l (mul $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (mul $u $v))))
((arule div $l) (, (todo $l (div $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (div $u $v))))
; pow decomposes only its base; the exponent is part of the constructor
((arule pow $l) (, (todo $l (pow $u (num $n))))
                (, (todo (S $l) $u) (sub (pow $u (num $n)))))
((arule pow $l) (, (todo $l (pow $u (flt $n))))
                (, (todo (S $l) $u) (sub (pow $u (flt $n)))))
((arule neg $l) (, (todo $l (neg $u)))
                (, (todo (S $l) $u) (sub (neg $u))))
((arule sin $l) (, (todo $l (sin $u)))
                (, (todo (S $l) $u) (sub (sin $u))))
((arule cos $l) (, (todo $l (cos $u)))
                (, (todo (S $l) $u) (sub (cos $u))))
((arule exp $l) (, (todo $l (exp $u)))
                (, (todo (S $l) $u) (sub (exp $u))))
; binary exp is constant-exponent power; unary exp remains e^u
((arule expf $l) (, (todo $l (exp $u (flt $n))))
                 (, (todo (S $l) $u) (sub (exp $u (flt $n)))))
((arule expn $l) (, (todo $l (exp $u (num $n))))
                 (, (todo (S $l) $u) (sub (exp $u (num $n)))))
((arule ln $l)  (, (todo $l (ln $u)))
                (, (todo (S $l) $u) (sub (ln $u))))

(exec (az Z)
  (, (exec (az $l) $p $t)
     (todo $l $_)
     ((arule $k $l) $ap $at))
  (, (exec (a0 ($l $k)) $ap $at)
     (exec (az (S $l)) $p $t)
     (level $l)))

; ---------------------------------------------------------------------
; Base derivatives: dispatch on leaf constructors, one-shot each
; ---------------------------------------------------------------------
(exec (b0 cst) (, (todo $l (cst $c))) (, (d (cst $c) (num 0))))
(exec (b0 flt) (, (todo $l (flt $f))) (, (d (flt $f) (num 0))))
(exec (b0 num) (, (todo $l (num $n))) (, (d (num $n) (num 0))))
(exec (b0 var) (, (todo $l (var $x))) (, (d (var $x) (num 1))))

; pow exponent decrement, m = n - 1, computed by Rust; the (num $n)
; pattern guarantees the argument parses
(exec (b0 pow)
  (, (sub (pow $u (num $n))))
  (O (pure (expm1 (num $n) (num $m)) $m
           (i64_to_string (sub_i64 (i64_from_string $n) (i64_one))))))

(exec (b0 powf)
  (, (sub (pow $u (flt $n))))
  (O (pure (expm1 (flt $n) (flt $m)) $m
           (f64_to_string (sub_f64 (f64_from_string $n) (f64_from_string 1.0))))))

; ---------------------------------------------------------------------
(exec (b0 expf)
  (, (sub (exp $u (flt $n))))
  (O (pure (expm1 (flt $n) (flt $m)) $m
           (f64_to_string (sub_f64 (f64_from_string $n) (f64_from_string 1.0))))))
(exec (b0 expn)
  (, (sub (exp $u (num $n))))
  (O (pure (expm1 (num $n) (num $m)) $m
           (i64_to_string (sub_i64 (i64_from_string $n) (i64_one))))))

; Phase B: combination rules, stored as data (level-free)
; ---------------------------------------------------------------------
((brule add) (, (sub (add $u $v)) (d $u $du) (d $v $dv))
             (, (d (add $u $v) (add $du $dv))))
((brule sub) (, (sub (sub $u $v)) (d $u $du) (d $v $dv))
             (, (d (sub $u $v) (sub $du $dv))))
((brule mul) (, (sub (mul $u $v)) (d $u $du) (d $v $dv))
             (, (d (mul $u $v) (add (mul $du $v) (mul $u $dv)))))
((brule div) (, (sub (div $u $v)) (d $u $du) (d $v $dv))
             (, (d (div $u $v) (div (sub (mul $du $v) (mul $u $dv)) (mul $v $v)))))
((brule pow) (, (sub (pow $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du))
             (, (d (pow $u (num $n)) (mul (mul (num $n) (pow $u (num $m))) $du))))
((brule pow) (, (sub (pow $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du))
             (, (d (pow $u (flt $n)) (mul (mul (flt $n) (pow $u (flt $m))) $du))))
((brule neg) (, (sub (neg $u)) (d $u $du))
             (, (d (neg $u) (neg $du))))
((brule sin) (, (sub (sin $u)) (d $u $du))
             (, (d (sin $u) (mul (cos $u) $du))))
((brule cos) (, (sub (cos $u)) (d $u $du))
             (, (d (cos $u) (neg (mul (sin $u) $du)))))
((brule expf) (, (sub (exp $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du))
              (, (d (exp $u (flt $n)) (mul $du (mul (flt $n) (exp $u (flt $m)))))))
((brule expn) (, (sub (exp $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du))
              (, (d (exp $u (num $n)) (mul $du (mul (num $n) (exp $u (num $m)))))))
((brule exp) (, (sub (exp $u)) (d $u $du))
             (, (d (exp $u) (mul (exp $u) $du))))
((brule ln)  (, (sub (ln $u)) (d $u $du))
             (, (d (ln $u) (div $du $u))))

(exec (cz Z)
  (, (exec (cz $l) $p $t)
     (level $l)
     ((brule $k) $bp $bt))
  (, (exec (c0 ($l $k)) $bp $bt)
     (exec (cz (S $l)) $p $t)))

; ---------------------------------------------------------------------
; Collect
; ---------------------------------------------------------------------
(exec (zz out) (, (diff $e) (d $e $de)) (, (result $e $de)))
