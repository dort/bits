; =====================================================================
; Symbolic differentiation with FUSED simplification — clean (typed-AST)
; =====================================================================
;
; A standalone alternative to diff_engine.mm2 + simplify.mm2 that never
; writes an unsimplified derivative. Same typed AST, same inputs, same
; outputs on redundancy-free inputs:
;   leaves (num N) (flt F) (var x) (cst c); compounds (add/sub/mul/div u v),
;   (pow u (num N)|(flt F)), (neg/sin/cos/exp/ln u); input (diff EXPR);
;   output (result EXPR D) with D simplified.
;
; One semantic difference from the post-process pair: input subterms
; copied verbatim into a derivative (the u in (mul (cos u) du)) are NOT
; simplified here; the post-process pass simplifies everything it walks.
;
; Every derivative is built one node at a time through smart-constructor
; facts — (mkq E) requests the simplified form of a node whose children
; are already simplified values, (mkd E S) answers it, keyed by the
; request — because the plain engine's combination templates build
; multi-level trees whose nested redundancy no root-level rule set can
; reach. Like simplify.mm2, resolution is CLEAN: no default rule, no
; deletions — a total case analysis over reified dispatch facts, with
; overlapping rules always agreeing. Requests persist; answers are
; monotonic.
; Canonical form for the commutative constructors puts a lone numeric
; operand on the left: (add/mul E NUMBER) answers as
; (add/mul NUMBER E), after identity reduction.
;
; Dispatch facts (phase p2 below): (val V), (ctor V c), (isexpr V),
; (def V), (zn/on/mn V ...) via the pure sink's ifnz, and (vne A B) via
; the != source — see simplify.mm2's header for their meanings. Values
; here are everything appearing as an mkq argument (which covers d and
; mkd values and verbatim input subterms alike).
;
; Combination phases per construction round, baked into the rule store
; as ((qrule PHASE NAME) P T):
;   p1  derivative logic: issue requests, complete (d E DE) facts
;   p2  classify request-argument values (rule names are uniform
;       4-character symbols so the dependency chain aval->ctor->isexpr
;       ->def->zn/on/mn->vne runs in name order inside one round —
;       symbol priority is length-first, so mixed lengths would reorder
;       the chain)
;   p3  resolve requests into (mkd E S)
; A derivative is a chain of up to three requests plus its completion
; (quotient, power), so the driver runs FOUR rounds per depth level:
; instance tags (c0 ((l r ph) k)) sort round-major then phase-major.
;
; Phase layout: (0 _) < (a0/az _) < (b0 _) < (c0/cz _) < (zz _).

; ---------------------------------------------------------------------
; Setup
; ---------------------------------------------------------------------
(exec (0 root) (, (diff $e)) (, (todo Z $e)))

; ---------------------------------------------------------------------
; Phase A: decomposition (identical to diff_engine.mm2)
; ---------------------------------------------------------------------
((arule add $l) (, (todo $l (add $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (add $u $v))))
((arule sub $l) (, (todo $l (sub $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (sub $u $v))))
((arule mul $l) (, (todo $l (mul $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (mul $u $v))))
((arule div $l) (, (todo $l (div $u $v)))
                (, (todo (S $l) $u) (todo (S $l) $v) (sub (div $u $v))))
((arule pow $l) (, (todo $l (pow $u (num $n))))
                (, (todo (S $l) $u) (sub (pow $u (num $n)))))
((arule pow $l) (, (todo $l (pow $u (flt $n))))
                (, (todo (S $l) $u) (sub (pow $u (flt $n)))))
((arule neg $l) (, (todo $l (neg $u)))
                (, (todo (S $l) $u) (sub (neg $u))))
((arule sin $l) (, (todo $l (sin $u)))
                (, (todo (S $l) $u) (sub (sin $u))))
((arule cos $l) (, (todo $l (cos $u)))
                (, (todo (S $l) $u) (sub (cos $u))))
((arule exp $l) (, (todo $l (exp $u)))
                (, (todo (S $l) $u) (sub (exp $u))))
((arule expf $l) (, (todo $l (exp $u (flt $n))))
                 (, (todo (S $l) $u) (sub (exp $u (flt $n)))))
((arule expn $l) (, (todo $l (exp $u (num $n))))
                 (, (todo (S $l) $u) (sub (exp $u (num $n)))))
((arule ln $l)  (, (todo $l (ln $u)))
                (, (todo (S $l) $u) (sub (ln $u))))

(exec (az Z)
  (, (exec (az $l) $p $t)
     (todo $l $_)
     ((arule $k $l) $ap $at))
  (, (exec (a0 ($l $k)) $ap $at)
     (exec (az (S $l)) $p $t)
     (level $l)))

; ---------------------------------------------------------------------
; Base derivatives (identical to diff_engine.mm2)
; ---------------------------------------------------------------------
(exec (b0 cst) (, (todo $l (cst $c))) (, (d (cst $c) (num 0))))
(exec (b0 flt) (, (todo $l (flt $f))) (, (d (flt $f) (num 0))))
(exec (b0 num) (, (todo $l (num $n))) (, (d (num $n) (num 0))))
(exec (b0 var) (, (todo $l (var $x))) (, (d (var $x) (num 1))))

(exec (b0 pow)
  (, (sub (pow $u (num $n))))
  (O (pure (expm1 (num $n) (num $m)) $m
           (i64_to_string (sub_i64 (i64_from_string $n) (i64_one))))))

; ---------------------------------------------------------------------
(exec (b0 powf)
  (, (sub (pow $u (flt $n))))
  (O (pure (expm1 (flt $n) (flt $m)) $m
           (f64_to_string (sub_f64 (f64_from_string $n) (f64_from_string 1.0))))))

(exec (b0 expf)
  (, (sub (exp $u (flt $n))))
  (O (pure (expm1 (flt $n) (flt $m)) $m
           (f64_to_string (sub_f64 (f64_from_string $n) (f64_from_string 1.0))))))
(exec (b0 expn)
  (, (sub (exp $u (num $n))))
  (O (pure (expm1 (num $n) (num $m)) $m
           (i64_to_string (sub_i64 (i64_from_string $n) (i64_one))))))

; p1: derivative logic — request chains and completions
; ---------------------------------------------------------------------
((qrule p1 addq) (, (sub (add $u $v)) (d $u $du) (d $v $dv))
                 (, (mkq (add $du $dv))))
((qrule p1 addd) (, (sub (add $u $v)) (d $u $du) (d $v $dv)
                    (mkd (add $du $dv) $r))
                 (, (d (add $u $v) $r)))

((qrule p1 subq) (, (sub (sub $u $v)) (d $u $du) (d $v $dv))
                 (, (mkq (sub $du $dv))))
((qrule p1 subd) (, (sub (sub $u $v)) (d $u $du) (d $v $dv)
                    (mkd (sub $du $dv) $r))
                 (, (d (sub $u $v) $r)))

((qrule p1 mulq1) (, (sub (mul $u $v)) (d $u $du) (d $v $dv))
                  (, (mkq (mul $du $v)) (mkq (mul $u $dv))))
((qrule p1 mulq2) (, (sub (mul $u $v)) (d $u $du) (d $v $dv)
                     (mkd (mul $du $v) $r1) (mkd (mul $u $dv) $r2))
                  (, (mkq (add $r1 $r2))))
((qrule p1 muld)  (, (sub (mul $u $v)) (d $u $du) (d $v $dv)
                     (mkd (mul $du $v) $r1) (mkd (mul $u $dv) $r2)
                     (mkd (add $r1 $r2) $r))
                  (, (d (mul $u $v) $r)))

((qrule p1 divq1) (, (sub (div $u $v)) (d $u $du) (d $v $dv))
                  (, (mkq (mul $du $v)) (mkq (mul $u $dv)) (mkq (mul $v $v))))
((qrule p1 divq2) (, (sub (div $u $v)) (d $u $du) (d $v $dv)
                     (mkd (mul $du $v) $r1) (mkd (mul $u $dv) $r2))
                  (, (mkq (sub $r1 $r2))))
((qrule p1 divq3) (, (sub (div $u $v)) (d $u $du) (d $v $dv)
                     (mkd (mul $du $v) $r1) (mkd (mul $u $dv) $r2)
                     (mkd (sub $r1 $r2) $r3) (mkd (mul $v $v) $r4))
                  (, (mkq (div $r3 $r4))))
((qrule p1 divd)  (, (sub (div $u $v)) (d $u $du) (d $v $dv)
                     (mkd (mul $du $v) $r1) (mkd (mul $u $dv) $r2)
                     (mkd (sub $r1 $r2) $r3) (mkd (mul $v $v) $r4)
                     (mkd (div $r3 $r4) $r))
                  (, (d (div $u $v) $r)))

((qrule p1 powq1) (, (sub (pow $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du))
                  (, (mkq (pow $u (num $m)))))
((qrule p1 powq2) (, (sub (pow $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                     (mkd (pow $u (num $m)) $r1))
                  (, (mkq (mul (num $n) $r1))))
((qrule p1 powq3) (, (sub (pow $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                     (mkd (pow $u (num $m)) $r1) (mkd (mul (num $n) $r1) $r2))
                  (, (mkq (mul $r2 $du))))
((qrule p1 powd)  (, (sub (pow $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                     (mkd (pow $u (num $m)) $r1) (mkd (mul (num $n) $r1) $r2)
                     (mkd (mul $r2 $du) $r))
                  (, (d (pow $u (num $n)) $r)))

((qrule p1 powq1) (, (sub (pow $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du))
                  (, (mkq (pow $u (flt $m)))))
((qrule p1 powq2) (, (sub (pow $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                     (mkd (pow $u (flt $m)) $r1))
                  (, (mkq (mul (flt $n) $r1))))
((qrule p1 powq3) (, (sub (pow $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                     (mkd (pow $u (flt $m)) $r1) (mkd (mul (flt $n) $r1) $r2))
                  (, (mkq (mul $r2 $du))))
((qrule p1 powd)  (, (sub (pow $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                     (mkd (pow $u (flt $m)) $r1) (mkd (mul (flt $n) $r1) $r2)
                     (mkd (mul $r2 $du) $r))
                  (, (d (pow $u (flt $n)) $r)))

((qrule p1 negq) (, (sub (neg $u)) (d $u $du))
                 (, (mkq (neg $du))))
((qrule p1 negd) (, (sub (neg $u)) (d $u $du) (mkd (neg $du) $r))
                 (, (d (neg $u) $r)))

((qrule p1 sinq) (, (sub (sin $u)) (d $u $du))
                 (, (mkq (mul (cos $u) $du))))
((qrule p1 sind) (, (sub (sin $u)) (d $u $du) (mkd (mul (cos $u) $du) $r))
                 (, (d (sin $u) $r)))

((qrule p1 cosq1) (, (sub (cos $u)) (d $u $du))
                  (, (mkq (mul (sin $u) $du))))
((qrule p1 cosq2) (, (sub (cos $u)) (d $u $du) (mkd (mul (sin $u) $du) $r1))
                  (, (mkq (neg $r1))))
((qrule p1 cosd)  (, (sub (cos $u)) (d $u $du) (mkd (mul (sin $u) $du) $r1)
                     (mkd (neg $r1) $r))
                  (, (d (cos $u) $r)))

((qrule p1 expq) (, (sub (exp $u)) (d $u $du))
                 (, (mkq (mul (exp $u) $du))))
((qrule p1 expd) (, (sub (exp $u)) (d $u $du) (mkd (mul (exp $u) $du) $r))
                 (, (d (exp $u) $r)))

((qrule p1 expfq1) (, (sub (exp $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du))
                   (, (mkq (exp $u (flt $m)))))
((qrule p1 expfq2) (, (sub (exp $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                      (mkd (exp $u (flt $m)) $r1))
                   (, (mkq (mul (flt $n) $r1))))
((qrule p1 expfq3) (, (sub (exp $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                      (mkd (exp $u (flt $m)) $r1) (mkd (mul (flt $n) $r1) $r2))
                   (, (mkq (mul $du $r2))))
((qrule p1 expfd)  (, (sub (exp $u (flt $n))) (expm1 (flt $n) (flt $m)) (d $u $du)
                      (mkd (exp $u (flt $m)) $r1) (mkd (mul (flt $n) $r1) $r2)
                      (mkd (mul $du $r2) $r))
                   (, (d (exp $u (flt $n)) $r)))

((qrule p1 expnq1) (, (sub (exp $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du))
                   (, (mkq (exp $u (num $m)))))
((qrule p1 expnq2) (, (sub (exp $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                      (mkd (exp $u (num $m)) $r1))
                   (, (mkq (mul (num $n) $r1))))
((qrule p1 expnq3) (, (sub (exp $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                      (mkd (exp $u (num $m)) $r1) (mkd (mul (num $n) $r1) $r2))
                   (, (mkq (mul $du $r2))))
((qrule p1 expnd)  (, (sub (exp $u (num $n))) (expm1 (num $n) (num $m)) (d $u $du)
                      (mkd (exp $u (num $m)) $r1) (mkd (mul (num $n) $r1) $r2)
                      (mkd (mul $du $r2) $r))
                   (, (d (exp $u (num $n)) $r)))

((qrule p1 lnq) (, (sub (ln $u)) (d $u $du))
                (, (mkq (div $du $u))))
((qrule p1 lnd) (, (sub (ln $u)) (d $u $du) (mkd (div $du $u) $r))
                (, (d (ln $u) $r)))

; ---------------------------------------------------------------------
; p2: classification (uniform 4-character names, chain in name order)
; ---------------------------------------------------------------------
((qrule p2 avaB) (, (mkq ($f $a $b))) (, (val $a) (val $b)))
((qrule p2 avaU) (, (mkq ($f $a))) (, (val $a)))

((qrule p2 cbin) (, (val ($f $a $b))) (, (ctor ($f $a $b) $f)))
((qrule p2 ccst) (, (val (cst $c))) (, (ctor (cst $c) cst)))
((qrule p2 ccos) (, (val (cos $u))) (, (ctor (cos $u) cos)))
((qrule p2 cexp) (, (val (exp $u))) (, (ctor (exp $u) exp)))
((qrule p2 clnn) (, (val (ln $u)))  (, (ctor (ln $u) ln)))
((qrule p2 cneg) (, (val (neg $u))) (, (ctor (neg $u) neg)))
((qrule p2 cflt) (, (val (flt $f))) (, (ctor (flt $f) flt)))
((qrule p2 cnum) (, (val (num $n))) (, (ctor (num $n) num)))
((qrule p2 csin) (, (val (sin $u))) (, (ctor (sin $u) sin)))
((qrule p2 cvar) (, (val (var $x))) (, (ctor (var $x) var)))

((qrule p2 iexp) (, (ctor $v $c) (exprtag $c)) (, (isexpr $v)))
((qrule p2 jdfe) (, (isexpr $v)) (, (def $v)))
((qrule p2 jdfn) (, (ctor $v num)) (, (def $v)))
((qrule p2 jdff) (, (ctor $v flt)) (, (def $v)))

((qrule p2 nzmm) (, (val (num $n)))
                 (O (pure (mn (num $n) $r) $r
                          (ifnz (sum_i64 (i64_from_string $n) (i64_one)) then NM else M))))
((qrule p2 nzoo) (, (val (num $n)))
                 (O (pure (on (num $n) $r) $r
                          (ifnz (sub_i64 (i64_from_string $n) (i64_one)) then NO else O))))
((qrule p2 nzzz) (, (val (num $n)))
                 (O (pure (zn (num $n) $r) $r
                          (ifnz (i64_from_string $n) then NZ else Z))))

((qrule p2 nfmm) (, (val (flt $n)))
                 (O (pure (mn (flt $n) $r) $r
                          (ifnz (sum_f64 (f64_from_string $n) (f64_from_string 1.0)) then NM else M))))
((qrule p2 nfoo) (, (val (flt $n)))
                 (O (pure (on (flt $n) $r) $r
                          (ifnz (sub_f64 (f64_from_string $n) (f64_from_string 1.0)) then NO else O))))
((qrule p2 nfzz) (, (val (flt $n)))
                 (O (pure (zn (flt $n) $r) $r
                          (ifnz (sum_f64 (f64_from_string $n) (f64_from_string 0.0)) then NZ else Z))))

((qrule p2 znee) (I (!= (val $x) (val $y))) (, (vne $x $y)))

(exprtag add) (exprtag sub) (exprtag mul) (exprtag div) (exprtag pow)
(exprtag neg) (exprtag sin) (exprtag cos) (exprtag exp) (exprtag ln)
(exprtag var) (exprtag cst)
(negtag add) (negtag sub) (negtag mul) (negtag div) (negtag pow)
(negtag sin) (negtag cos) (negtag exp) (negtag ln)
(negtag var) (negtag cst)

; ---------------------------------------------------------------------
; p3: resolve requests — total case analysis per constructor (the same
; rule set as simplify.mm2's zzf phase, on requests instead of subterms)
; ---------------------------------------------------------------------
((qrule p3 addFF) (, (mkq (add (flt $a) (flt $b))))
                   (O (pure (mkd (add (flt $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (sum_f64 (f64_from_string $a) (f64_from_string $b))))))
((qrule p3 addIF) (, (mkq (add (num $a) (flt $b))))
                   (O (pure (mkd (add (num $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (sum_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((qrule p3 addFI) (, (mkq (add (flt $a) (num $b))))
                   (O (pure (mkd (add (flt $a) (num $b)) (flt $r)) $r
                            (f64_to_string (sum_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((qrule p3 addf)  (, (mkq (add (num $a) (num $b))))
                  (O (pure (mkd (add (num $a) (num $b)) (num $r)) $r
                           (i64_to_string (sum_i64 (i64_from_string $a) (i64_from_string $b))))))
((qrule p3 addzL) (, (mkq (add (num 0) $b)) (isexpr $b))
                  (, (mkd (add (num 0) $b) $b)))
((qrule p3 addzR) (, (mkq (add $a (num 0))) (isexpr $a))
                  (, (mkd (add $a (num 0)) $a)))
((qrule p3 addzFL) (, (mkq (add $a $b)) (ctor $a flt) (zn $a Z) (isexpr $b))
                   (, (mkd (add $a $b) $b)))
((qrule p3 addzFR) (, (mkq (add $a $b)) (isexpr $a) (ctor $b flt) (zn $b Z))
                   (, (mkd (add $a $b) $a)))
((qrule p3 addbL) (, (mkq (add $a $b)) (zn $a NZ) (isexpr $b))
                  (, (mkd (add $a $b) (add $a $b))))
((qrule p3 addbR) (, (mkq (add $a $b)) (isexpr $a) (zn $b NZ))
                  (, (mkd (add $a $b) (add $b $a))))
((qrule p3 addbE) (, (mkq (add $a $b)) (isexpr $a) (isexpr $b))
                  (, (mkd (add $a $b) (add $a $b))))
((qrule p3 adduL) (, (mkq (add UNDEFINED $b)) (val $b))
                  (, (mkd (add UNDEFINED $b) UNDEFINED)))
((qrule p3 adduR) (, (mkq (add $a UNDEFINED)) (val $a))
                  (, (mkd (add $a UNDEFINED) UNDEFINED)))

((qrule p3 subFF) (, (mkq (sub (flt $a) (flt $b))))
                   (O (pure (mkd (sub (flt $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (sub_f64 (f64_from_string $a) (f64_from_string $b))))))
((qrule p3 subIF) (, (mkq (sub (num $a) (flt $b))))
                   (O (pure (mkd (sub (num $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (sub_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((qrule p3 subFI) (, (mkq (sub (flt $a) (num $b))))
                   (O (pure (mkd (sub (flt $a) (num $b)) (flt $r)) $r
                            (f64_to_string (sub_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((qrule p3 subf)  (, (mkq (sub (num $a) (num $b))))
                  (O (pure (mkd (sub (num $a) (num $b)) (num $r)) $r
                           (i64_to_string (sub_i64 (i64_from_string $a) (i64_from_string $b))))))
((qrule p3 subzR) (, (mkq (sub $a (num 0))) (isexpr $a))
                  (, (mkd (sub $a (num 0)) $a)))
((qrule p3 subxx) (, (mkq (sub $x $x)) (isexpr $x))
                  (, (mkd (sub $x $x) (num 0))))
((qrule p3 subzF) (, (mkq (sub $a $b)) (isexpr $a) (ctor $b flt) (zn $b Z))
                  (, (mkd (sub $a $b) $a)))
((qrule p3 subbF) (, (mkq (sub $a $b)) (ctor $a flt) (isexpr $b))
                  (, (mkd (sub $a $b) (sub $a $b))))
((qrule p3 subbL) (, (mkq (sub $a $b)) (ctor $a num) (isexpr $b))
                  (, (mkd (sub $a $b) (sub $a $b))))
((qrule p3 subbR) (, (mkq (sub $a $b)) (isexpr $a) (zn $b NZ))
                  (, (mkd (sub $a $b) (sub $a $b))))
((qrule p3 subbE) (, (mkq (sub $a $b)) (isexpr $a) (isexpr $b) (vne $a $b))
                  (, (mkd (sub $a $b) (sub $a $b))))
((qrule p3 subuL) (, (mkq (sub UNDEFINED $b)) (val $b))
                  (, (mkd (sub UNDEFINED $b) UNDEFINED)))
((qrule p3 subuR) (, (mkq (sub $a UNDEFINED)) (val $a))
                  (, (mkd (sub $a UNDEFINED) UNDEFINED)))

((qrule p3 mulFF) (, (mkq (mul (flt $a) (flt $b))))
                   (O (pure (mkd (mul (flt $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (product_f64 (f64_from_string $a) (f64_from_string $b))))))
((qrule p3 mulIF) (, (mkq (mul (num $a) (flt $b))))
                   (O (pure (mkd (mul (num $a) (flt $b)) (flt $r)) $r
                            (f64_to_string (product_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((qrule p3 mulFI) (, (mkq (mul (flt $a) (num $b))))
                   (O (pure (mkd (mul (flt $a) (num $b)) (flt $r)) $r
                            (f64_to_string (product_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((qrule p3 mulf)  (, (mkq (mul (num $a) (num $b))))
                  (O (pure (mkd (mul (num $a) (num $b)) (num $r)) $r
                           (i64_to_string (product_i64 (i64_from_string $a) (i64_from_string $b))))))
((qrule p3 mulzL) (, (mkq (mul (num 0) $b)) (isexpr $b))
                  (, (mkd (mul (num 0) $b) (num 0))))
((qrule p3 mulzR) (, (mkq (mul $a (num 0))) (isexpr $a))
                  (, (mkd (mul $a (num 0)) (num 0))))
((qrule p3 mul1L) (, (mkq (mul (num 1) $b)) (isexpr $b))
                  (, (mkd (mul (num 1) $b) $b)))
((qrule p3 mul1R) (, (mkq (mul $a (num 1))) (isexpr $a))
                  (, (mkd (mul $a (num 1)) $a)))
((qrule p3 mulmL) (, (mkq (mul (num -1) $b)) (isexpr $b))
                  (, (mkd (mul (num -1) $b) (neg $b))))
((qrule p3 mulmR) (, (mkq (mul $a (num -1))) (isexpr $a))
                  (, (mkd (mul $a (num -1)) (neg $a))))
((qrule p3 mulzFL) (, (mkq (mul $a $b)) (ctor $a flt) (zn $a Z) (isexpr $b))
                   (, (mkd (mul $a $b) (flt 0.0))))
((qrule p3 mulzFR) (, (mkq (mul $a $b)) (isexpr $a) (ctor $b flt) (zn $b Z))
                   (, (mkd (mul $a $b) (flt 0.0))))
((qrule p3 mul1FL) (, (mkq (mul $a $b)) (ctor $a flt) (on $a O) (isexpr $b))
                   (, (mkd (mul $a $b) $b)))
((qrule p3 mul1FR) (, (mkq (mul $a $b)) (isexpr $a) (ctor $b flt) (on $b O))
                   (, (mkd (mul $a $b) $a)))
((qrule p3 mulmFL) (, (mkq (mul $a $b)) (ctor $a flt) (mn $a M) (isexpr $b))
                   (, (mkd (mul $a $b) (neg $b))))
((qrule p3 mulmFR) (, (mkq (mul $a $b)) (isexpr $a) (ctor $b flt) (mn $b M))
                   (, (mkd (mul $a $b) (neg $a))))
((qrule p3 mulbL) (, (mkq (mul $a $b)) (zn $a NZ) (on $a NO) (mn $a NM) (isexpr $b))
                  (, (mkd (mul $a $b) (mul $a $b))))
((qrule p3 mulbR) (, (mkq (mul $a $b)) (isexpr $a) (zn $b NZ) (on $b NO) (mn $b NM))
                  (, (mkd (mul $a $b) (mul $b $a))))
((qrule p3 mulbE) (, (mkq (mul $a $b)) (isexpr $a) (isexpr $b))
                  (, (mkd (mul $a $b) (mul $a $b))))
((qrule p3 muluL) (, (mkq (mul UNDEFINED $b)) (val $b))
                  (, (mkd (mul UNDEFINED $b) UNDEFINED)))
((qrule p3 muluR) (, (mkq (mul $a UNDEFINED)) (val $a))
                  (, (mkd (mul $a UNDEFINED) UNDEFINED)))

((qrule p3 divz)  (, (mkq (div $a (num 0))) (val $a))
                  (, (mkd (div $a (num 0)) UNDEFINED)))
((qrule p3 divzF) (, (mkq (div $a $b)) (ctor $b flt) (zn $b Z) (val $a))
                   (, (mkd (div $a $b) UNDEFINED)))
((qrule p3 div0Fa) (, (mkq (div $a $b)) (ctor $a flt) (zn $a Z) (isexpr $b))
                    (, (mkd (div $a $b) (flt 0.0))))
((qrule p3 div0Fb) (, (mkq (div $a $b)) (ctor $a flt) (zn $a Z) (zn $b NZ))
                    (, (mkd (div $a $b) (flt 0.0))))
((qrule p3 div1F) (, (mkq (div $a $b)) (ctor $b flt) (on $b O) (def $a))
                   (, (mkd (div $a $b) $a)))
((qrule p3 div0a) (, (mkq (div (num 0) $b)) (isexpr $b))
                  (, (mkd (div (num 0) $b) (num 0))))
((qrule p3 div0b) (, (mkq (div (num 0) $b)) (zn $b NZ))
                  (, (mkd (div (num 0) $b) (num 0))))
((qrule p3 div1)  (, (mkq (div $a (num 1))) (def $a))
                  (, (mkd (div $a (num 1)) $a)))
((qrule p3 divxE) (, (mkq (div $x $x)) (isexpr $x))
                  (, (mkd (div $x $x) (num 1))))
((qrule p3 divxN) (, (mkq (div $x $x)) (zn $x NZ))
                  (, (mkd (div $x $x) (num 1))))
((qrule p3 divbNN) (, (mkq (div $a $b)) (zn $a NZ) (zn $b NZ) (on $b NO) (vne $a $b))
                   (, (mkd (div $a $b) (div $a $b))))
((qrule p3 divbNE) (, (mkq (div $a $b)) (zn $a NZ) (isexpr $b))
                   (, (mkd (div $a $b) (div $a $b))))
((qrule p3 divbEN) (, (mkq (div $a $b)) (isexpr $a) (zn $b NZ) (on $b NO))
                   (, (mkd (div $a $b) (div $a $b))))
((qrule p3 divbEE) (, (mkq (div $a $b)) (isexpr $a) (isexpr $b) (vne $a $b))
                   (, (mkd (div $a $b) (div $a $b))))
((qrule p3 divuL) (, (mkq (div UNDEFINED $b)) (val $b))
                  (, (mkd (div UNDEFINED $b) UNDEFINED)))
((qrule p3 divuR) (, (mkq (div $a UNDEFINED)) (val $a))
                  (, (mkd (div $a UNDEFINED) UNDEFINED)))

((qrule p3 pow1F) (, (mkq (pow $a (flt $n))) (on (flt $n) O) (def $a))
                  (, (mkd (pow $a (flt $n)) $a)))
((qrule p3 pow0F) (, (mkq (pow $a (flt $n))) (zn (flt $n) Z) (def $a))
                  (, (mkd (pow $a (flt $n)) (num 1))))
((qrule p3 powbF) (, (mkq (pow $a (flt $n))) (def $a) (zn (flt $n) NZ) (on (flt $n) NO))
                  (, (mkd (pow $a (flt $n)) (pow $a (flt $n)))))
((qrule p3 powuF) (, (mkq (pow UNDEFINED (flt $n))) (val (flt $n)))
                  (, (mkd (pow UNDEFINED (flt $n)) UNDEFINED)))
((qrule p3 pow1) (, (mkq (pow $a (num 1))) (def $a))
                 (, (mkd (pow $a (num 1)) $a)))
((qrule p3 pow0) (, (mkq (pow $a (num 0))) (def $a))
                 (, (mkd (pow $a (num 0)) (num 1))))
((qrule p3 powb) (, (mkq (pow $a (num $n))) (def $a) (zn (num $n) NZ) (on (num $n) NO))
                 (, (mkd (pow $a (num $n)) (pow $a (num $n)))))
((qrule p3 powu) (, (mkq (pow UNDEFINED (num $n))) (val (num $n)))
                 (, (mkd (pow UNDEFINED (num $n)) UNDEFINED)))

((qrule p3 negF) (, (mkq (neg (flt $a))))
                  (O (pure (mkd (neg (flt $a)) (flt $r)) $r
                           (f64_to_string (sub_f64 (f64_from_string 0.0) (f64_from_string $a))))))
((qrule p3 negf) (, (mkq (neg (num $a))))
                 (O (pure (mkd (neg (num $a)) (num $r)) $r
                          (i64_to_string (sub_i64 (i64_from_string 0) (i64_from_string $a))))))
((qrule p3 negn) (, (mkq (neg (neg $x))))
                 (, (mkd (neg (neg $x)) $x)))
((qrule p3 negb) (, (mkq (neg $a)) (ctor $a $c) (negtag $c))
                 (, (mkd (neg $a) (neg $a))))
((qrule p3 negu) (, (mkq (neg UNDEFINED)))
                 (, (mkd (neg UNDEFINED) UNDEFINED)))

((qrule p3 sinb) (, (mkq (sin $a)) (def $a)) (, (mkd (sin $a) (sin $a))))
((qrule p3 sinu) (, (mkq (sin UNDEFINED))) (, (mkd (sin UNDEFINED) UNDEFINED)))
((qrule p3 cosb) (, (mkq (cos $a)) (def $a)) (, (mkd (cos $a) (cos $a))))
((qrule p3 cosu) (, (mkq (cos UNDEFINED))) (, (mkd (cos UNDEFINED) UNDEFINED)))
((qrule p3 expb) (, (mkq (exp $a)) (def $a)) (, (mkd (exp $a) (exp $a))))
((qrule p3 expu) (, (mkq (exp UNDEFINED))) (, (mkd (exp UNDEFINED) UNDEFINED)))
((qrule p3 expfb) (, (mkq (exp $a (flt $n))) (def $a))
                  (, (mkd (exp $a (flt $n)) (exp $a (flt $n)))))
((qrule p3 expfu) (, (mkq (exp UNDEFINED (flt $n))))
                  (, (mkd (exp UNDEFINED (flt $n)) UNDEFINED)))
((qrule p3 expnb) (, (mkq (exp $a (num $n))) (def $a))
                  (, (mkd (exp $a (num $n)) (exp $a (num $n)))))
((qrule p3 expnu) (, (mkq (exp UNDEFINED (num $n))))
                  (, (mkd (exp UNDEFINED (num $n)) UNDEFINED)))
((qrule p3 lnb)  (, (mkq (ln $a)) (def $a)) (, (mkd (ln $a) (ln $a))))
((qrule p3 lnu)  (, (mkq (ln UNDEFINED))) (, (mkd (ln UNDEFINED) UNDEFINED)))

; ---------------------------------------------------------------------
; Combination driver: four p1/p2/p3 rounds per depth level
; ---------------------------------------------------------------------
(round r1)
(round r2)
(round r3)
(round r4)

(exec (cz Z)
  (, (exec (cz $l) $p $t)
     (level $l)
     (round $r)
     ((qrule $ph $k) $qp $qt))
  (, (exec (c0 (($l $r $ph) $k)) $qp $qt)
     (exec (cz (S $l)) $p $t)))

; ---------------------------------------------------------------------
; Collect
; ---------------------------------------------------------------------
(exec (zz out) (, (diff $e) (d $e $de)) (, (result $e $de)))
