; =====================================================================
; Post-process simplifier — clean (typed-AST) representation
; =====================================================================
;
; Opt-in layer: concatenate AFTER diff_engine.mm2. Rewrites every
; (result EXPR D) in place with D simplified:
;   (add (num 0) e) -> e            (sub e (num 0)) -> e
;   (sub e e) -> (num 0)            (mul (num 0) e) -> (num 0)
;   (mul (num 1) e) -> e            (mul (num -1) e) -> (neg e)
;   (div (num 0) e) -> (num 0)      (div e (num 1)) -> e
;   (div e e) -> (num 1)            (div e (num 0)) -> UNDEFINED
;   (pow e (num 1)) -> e            (pow e (num 0)) -> (num 1)
;   (neg (num n)) -> (num -n)       (neg (neg e)) -> e
;   integer add/sub/mul folded by Rust; UNDEFINED is contagious.
;   float add/sub/mul and mixed int/float arithmetic are grounded in
;   Rust; mixed operations promote to (flt F).
;   add/mul canonicalize a lone numeric operand to the left:
;     (add e NUMBER) -> (add NUMBER e)
;     (mul e NUMBER) -> (mul NUMBER e)
;   after the identity cases above have been applied.
;
; This is a CLEAN rule set in the Prolog sense: no default rule, no
; deletion-ordered else-branches, no classify-by-parse-failure. Every
; simplified value is classified once by pattern into reified dispatch
; facts, and every constructor's rules enumerate a total case analysis
; over those facts; overlapping rules always agree, so the whole layer
; is monotonic saturation.
;
; Dispatch facts (computed each sweep, phase zze, chained by rule name):
;   (val V)        V occurs as a simplified value
;   (ctor V c)     V's constructor tag (head symbol; variable-head
;                  pattern covers all binary constructors at once)
;   (isexpr V)     ctor is a compound or symbolic leaf (not num)
;   (def V)        V is any well-formed value (num or isexpr) — i.e.
;                  not UNDEFINED
;   (zn V NZ|Z)    (on V NO|O)   (mn V NM|M)
;                  V = (num n): n nonzero / one / minus-one tests,
;                  grounded in Rust via the pure sink's ifnz
;   (vne A B)      A and B are structurally different values, via the
;                  != source — the complement of unification, used by
;                  the sub/div build rules whose identity siblings
;                  (sub e e), (div e e) own the equal case
;
; Tags (3-character zz?, after the engine's 2-character tags, before
; the (zzt _) tests):
;   (zza _) seed   (zzb/zzc _) decompose   (zzd _) leaf s-facts
;   (zze _) classify   (zzf _) construct   (zzi _) sweep driver
;   (zzo _) replace results
; (s E S) means "E simplifies to S"; one sweep per (slevel l) fact.

; ---------------------------------------------------------------------
; Seed
; ---------------------------------------------------------------------
(exec (zza seed) (, (result $e $de)) (, (stodo Z $de)))

; ---------------------------------------------------------------------
; Decomposition (pow's exponent decomposes too: its (num n) needs
; classification for the pow dispatch)
; ---------------------------------------------------------------------
((drule add $l) (, (stodo $l (add $u $v)))
                (, (stodo (S $l) $u) (stodo (S $l) $v) (ssub (add $u $v))))
((drule sub $l) (, (stodo $l (sub $u $v)))
                (, (stodo (S $l) $u) (stodo (S $l) $v) (ssub (sub $u $v))))
((drule mul $l) (, (stodo $l (mul $u $v)))
                (, (stodo (S $l) $u) (stodo (S $l) $v) (ssub (mul $u $v))))
((drule div $l) (, (stodo $l (div $u $v)))
                (, (stodo (S $l) $u) (stodo (S $l) $v) (ssub (div $u $v))))
((drule pow $l) (, (stodo $l (pow $u (num $n))))
                (, (stodo (S $l) $u) (stodo (S $l) (num $n)) (ssub (pow $u (num $n)))))
((drule pow $l) (, (stodo $l (pow $u (flt $n))))
                (, (stodo (S $l) $u) (stodo (S $l) (flt $n)) (ssub (pow $u (flt $n)))))
((drule neg $l) (, (stodo $l (neg $u)))
                (, (stodo (S $l) $u) (ssub (neg $u))))
((drule sin $l) (, (stodo $l (sin $u)))
                (, (stodo (S $l) $u) (ssub (sin $u))))
((drule cos $l) (, (stodo $l (cos $u)))
                (, (stodo (S $l) $u) (ssub (cos $u))))
((drule exp $l) (, (stodo $l (exp $u)))
                (, (stodo (S $l) $u) (ssub (exp $u))))
((drule expf $l) (, (stodo $l (exp $u (flt $n))))
                 (, (stodo (S $l) $u) (stodo (S $l) (flt $n)) (ssub (exp $u (flt $n)))))
((drule expn $l) (, (stodo $l (exp $u (num $n))))
                 (, (stodo (S $l) $u) (stodo (S $l) (num $n)) (ssub (exp $u (num $n)))))
((drule ln $l)  (, (stodo $l (ln $u)))
                (, (stodo (S $l) $u) (ssub (ln $u))))

(exec (zzc Z)
  (, (exec (zzc $l) $p $t)
     (stodo $l $_)
     ((drule $k $l) $dp $dt))
  (, (exec (zzb ($l $k)) $dp $dt)
     (exec (zzc (S $l)) $p $t)
     (slevel $l)))

; ---------------------------------------------------------------------
; Leaf base cases: dispatch by constructor, one-shot each
; ---------------------------------------------------------------------
(exec (zzd cst) (, (stodo $l (cst $c))) (, (s (cst $c) (cst $c))))
(exec (zzd flt) (, (stodo $l (flt $f))) (, (s (flt $f) (flt $f))))
(exec (zzd num) (, (stodo $l (num $n))) (, (s (num $n) (num $n))))
(exec (zzd var) (, (stodo $l (var $x))) (, (s (var $x) (var $x))))

; ---------------------------------------------------------------------
; Classification rule store (phase zze). Within a sweep the instances
; run in rule-name order, so the dependency chain aval -> c* -> iex ->
; jdf* -> nz* -> zne resolves inside one sweep.
; ---------------------------------------------------------------------
((rrule zze aval) (, (s $_ $v)) (, (val $v)))

((rrule zze cbin) (, (val ($f $a $b))) (, (ctor ($f $a $b) $f)))
((rrule zze ccst) (, (val (cst $c))) (, (ctor (cst $c) cst)))
((rrule zze ccos) (, (val (cos $u))) (, (ctor (cos $u) cos)))
((rrule zze cexp) (, (val (exp $u))) (, (ctor (exp $u) exp)))
((rrule zze clnn)  (, (val (ln $u)))  (, (ctor (ln $u) ln)))
((rrule zze cneg) (, (val (neg $u))) (, (ctor (neg $u) neg)))
((rrule zze cflt) (, (val (flt $f))) (, (ctor (flt $f) flt)))
((rrule zze cnum) (, (val (num $n))) (, (ctor (num $n) num)))
((rrule zze csin) (, (val (sin $u))) (, (ctor (sin $u) sin)))
((rrule zze cvar) (, (val (var $x))) (, (ctor (var $x) var)))

((rrule zze iexp)  (, (ctor $v $c) (exprtag $c)) (, (isexpr $v)))
((rrule zze jdfe) (, (isexpr $v)) (, (def $v)))
((rrule zze jdfn) (, (ctor $v num)) (, (def $v)))
((rrule zze jdff) (, (ctor $v flt)) (, (def $v)))

((rrule zze nzmm) (, (val (num $n)))
                 (O (pure (mn (num $n) $r) $r
                          (ifnz (sum_i64 (i64_from_string $n) (i64_one)) then NM else M))))
((rrule zze nzoo) (, (val (num $n)))
                 (O (pure (on (num $n) $r) $r
                          (ifnz (sub_i64 (i64_from_string $n) (i64_one)) then NO else O))))
((rrule zze nzzz) (, (val (num $n)))
                 (O (pure (zn (num $n) $r) $r
                          (ifnz (i64_from_string $n) then NZ else Z))))

((rrule zze nfmm) (, (val (flt $n)))
                 (O (pure (mn (flt $n) $r) $r
                          (ifnz (sum_f64 (f64_from_string $n) (f64_from_string 1.0)) then NM else M))))
((rrule zze nfoo) (, (val (flt $n)))
                 (O (pure (on (flt $n) $r) $r
                          (ifnz (sub_f64 (f64_from_string $n) (f64_from_string 1.0)) then NO else O))))
((rrule zze nfzz) (, (val (flt $n)))
                 (O (pure (zn (flt $n) $r) $r
                          (ifnz (sum_f64 (f64_from_string $n) (f64_from_string 0.0)) then NZ else Z))))

((rrule zze znee) (I (!= (val $x) (val $y))) (, (vne $x $y)))

; constructor-tag sets, as data
(exprtag add) (exprtag sub) (exprtag mul) (exprtag div) (exprtag pow)
(exprtag neg) (exprtag sin) (exprtag cos) (exprtag exp) (exprtag ln)
(exprtag var) (exprtag cst)
; tags under which a neg is built verbatim (everything except num,
; owned by the neg fold, and neg, owned by double-negation)
(negtag add) (negtag sub) (negtag mul) (negtag div) (negtag pow)
(negtag sin) (negtag cos) (negtag exp) (negtag ln)
(negtag var) (negtag cst)

; ---------------------------------------------------------------------
; Constructor rule store (phase zzf): total case analysis per operator
; ---------------------------------------------------------------------
; add: (num,num) fold | zero drops | (num!=0,expr) build |
;      (expr,num!=0) canonicalize to (num,expr) | (expr,expr) build |
;      UNDEFINED contagion
((rrule zzf addFF) (, (ssub (add $u $v)) (s $u (flt $a)) (s $v (flt $b)))
                    (O (pure (s (add $u $v) (flt $r)) $r
                             (f64_to_string (sum_f64 (f64_from_string $a) (f64_from_string $b))))))
((rrule zzf addIF) (, (ssub (add $u $v)) (s $u (num $a)) (s $v (flt $b)))
                    (O (pure (s (add $u $v) (flt $r)) $r
                             (f64_to_string (sum_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((rrule zzf addFI) (, (ssub (add $u $v)) (s $u (flt $a)) (s $v (num $b)))
                    (O (pure (s (add $u $v) (flt $r)) $r
                             (f64_to_string (sum_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((rrule zzf addf)  (, (ssub (add $u $v)) (s $u (num $a)) (s $v (num $b)))
                   (O (pure (s (add $u $v) (num $r)) $r
                            (i64_to_string (sum_i64 (i64_from_string $a) (i64_from_string $b))))))
((rrule zzf addzL) (, (ssub (add $u $v)) (s $u (num 0)) (s $v $b) (isexpr $b))
                   (, (s (add $u $v) $b)))
((rrule zzf addzR) (, (ssub (add $u $v)) (s $v (num 0)) (s $u $a) (isexpr $a))
                   (, (s (add $u $v) $a)))
((rrule zzf addzFL) (, (ssub (add $u $v)) (s $u $a) (ctor $a flt) (zn $a Z) (s $v $b) (isexpr $b))
                    (, (s (add $u $v) $b)))
((rrule zzf addzFR) (, (ssub (add $u $v)) (s $u $a) (isexpr $a) (s $v $b) (ctor $b flt) (zn $b Z))
                    (, (s (add $u $v) $a)))
((rrule zzf addbL) (, (ssub (add $u $v)) (s $u $a) (zn $a NZ) (s $v $b) (isexpr $b))
                   (, (s (add $u $v) (add $a $b))))
((rrule zzf addbR) (, (ssub (add $u $v)) (s $u $a) (isexpr $a) (s $v $b) (zn $b NZ))
                   (, (s (add $u $v) (add $b $a))))
((rrule zzf addbE) (, (ssub (add $u $v)) (s $u $a) (isexpr $a) (s $v $b) (isexpr $b))
                   (, (s (add $u $v) (add $a $b))))
((rrule zzf adduL) (, (ssub (add $u $v)) (s $u UNDEFINED) (s $v $b) (val $b))
                   (, (s (add $u $v) UNDEFINED)))
((rrule zzf adduR) (, (ssub (add $u $v)) (s $v UNDEFINED) (s $u $a) (val $a))
                   (, (s (add $u $v) UNDEFINED)))

; sub: fold | minus-zero | same-operand (equality by unification) |
;      builds (the (expr,expr) build requires vne: the complement of
;      the same-operand rule) | contagion
((rrule zzf subFF) (, (ssub (sub $u $v)) (s $u (flt $a)) (s $v (flt $b)))
                    (O (pure (s (sub $u $v) (flt $r)) $r
                             (f64_to_string (sub_f64 (f64_from_string $a) (f64_from_string $b))))))
((rrule zzf subIF) (, (ssub (sub $u $v)) (s $u (num $a)) (s $v (flt $b)))
                    (O (pure (s (sub $u $v) (flt $r)) $r
                             (f64_to_string (sub_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((rrule zzf subFI) (, (ssub (sub $u $v)) (s $u (flt $a)) (s $v (num $b)))
                    (O (pure (s (sub $u $v) (flt $r)) $r
                             (f64_to_string (sub_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((rrule zzf subf)  (, (ssub (sub $u $v)) (s $u (num $a)) (s $v (num $b)))
                   (O (pure (s (sub $u $v) (num $r)) $r
                            (i64_to_string (sub_i64 (i64_from_string $a) (i64_from_string $b))))))
((rrule zzf subzR) (, (ssub (sub $u $v)) (s $v (num 0)) (s $u $a) (isexpr $a))
                   (, (s (sub $u $v) $a)))
((rrule zzf subxx) (, (ssub (sub $u $v)) (s $u $x) (s $v $x) (isexpr $x))
                   (, (s (sub $u $v) (num 0))))
((rrule zzf subzF) (, (ssub (sub $u $v)) (s $u $a) (isexpr $a) (s $v $b) (ctor $b flt) (zn $b Z))
                   (, (s (sub $u $v) $a)))
((rrule zzf subbF) (, (ssub (sub $u $v)) (s $u $a) (ctor $a flt) (s $v $b) (isexpr $b))
                   (, (s (sub $u $v) (sub $a $b))))
((rrule zzf subbL) (, (ssub (sub $u $v)) (s $u $a) (ctor $a num) (s $v $b) (isexpr $b))
                   (, (s (sub $u $v) (sub $a $b))))
((rrule zzf subbR) (, (ssub (sub $u $v)) (s $u $a) (isexpr $a) (s $v $b) (zn $b NZ))
                   (, (s (sub $u $v) (sub $a $b))))
((rrule zzf subbE) (, (ssub (sub $u $v)) (s $u $a) (isexpr $a) (s $v $b) (isexpr $b) (vne $a $b))
                   (, (s (sub $u $v) (sub $a $b))))
((rrule zzf subuL) (, (ssub (sub $u $v)) (s $u UNDEFINED) (s $v $b) (val $b))
                   (, (s (sub $u $v) UNDEFINED)))
((rrule zzf subuR) (, (ssub (sub $u $v)) (s $v UNDEFINED) (s $u $a) (val $a))
                   (, (s (sub $u $v) UNDEFINED)))

; mul: fold | zero | one | minus-one collapses to neg | builds
;      ((num,expr) builds need the num outside {0,1,-1}: zn/on/mn;
;      (expr,num) canonicalizes to (num,expr)) | contagion
((rrule zzf mulFF) (, (ssub (mul $u $v)) (s $u (flt $a)) (s $v (flt $b)))
                    (O (pure (s (mul $u $v) (flt $r)) $r
                             (f64_to_string (product_f64 (f64_from_string $a) (f64_from_string $b))))))
((rrule zzf mulIF) (, (ssub (mul $u $v)) (s $u (num $a)) (s $v (flt $b)))
                    (O (pure (s (mul $u $v) (flt $r)) $r
                             (f64_to_string (product_f64 (i64_as_f64 (i64_from_string $a)) (f64_from_string $b))))))
((rrule zzf mulFI) (, (ssub (mul $u $v)) (s $u (flt $a)) (s $v (num $b)))
                    (O (pure (s (mul $u $v) (flt $r)) $r
                             (f64_to_string (product_f64 (f64_from_string $a) (i64_as_f64 (i64_from_string $b)))))))

((rrule zzf mulf)  (, (ssub (mul $u $v)) (s $u (num $a)) (s $v (num $b)))
                   (O (pure (s (mul $u $v) (num $r)) $r
                            (i64_to_string (product_i64 (i64_from_string $a) (i64_from_string $b))))))
((rrule zzf mulzL) (, (ssub (mul $u $v)) (s $u (num 0)) (s $v $b) (isexpr $b))
                   (, (s (mul $u $v) (num 0))))
((rrule zzf mulzR) (, (ssub (mul $u $v)) (s $v (num 0)) (s $u $a) (isexpr $a))
                   (, (s (mul $u $v) (num 0))))
((rrule zzf mul1L) (, (ssub (mul $u $v)) (s $u (num 1)) (s $v $b) (isexpr $b))
                   (, (s (mul $u $v) $b)))
((rrule zzf mul1R) (, (ssub (mul $u $v)) (s $v (num 1)) (s $u $a) (isexpr $a))
                   (, (s (mul $u $v) $a)))
((rrule zzf mulmL) (, (ssub (mul $u $v)) (s $u (num -1)) (s $v $b) (isexpr $b))
                   (, (s (mul $u $v) (neg $b))))
((rrule zzf mulmR) (, (ssub (mul $u $v)) (s $v (num -1)) (s $u $a) (isexpr $a))
                   (, (s (mul $u $v) (neg $a))))
((rrule zzf mulzFL) (, (ssub (mul $u $v)) (s $u $a) (ctor $a flt) (zn $a Z) (s $v $b) (isexpr $b))
                    (, (s (mul $u $v) (flt 0.0))))
((rrule zzf mulzFR) (, (ssub (mul $u $v)) (s $u $a) (isexpr $a) (s $v $b) (ctor $b flt) (zn $b Z))
                    (, (s (mul $u $v) (flt 0.0))))
((rrule zzf mul1FL) (, (ssub (mul $u $v)) (s $u $a) (ctor $a flt) (on $a O) (s $v $b) (isexpr $b))
                    (, (s (mul $u $v) $b)))
((rrule zzf mul1FR) (, (ssub (mul $u $v)) (s $u $a) (isexpr $a) (s $v $b) (ctor $b flt) (on $b O))
                    (, (s (mul $u $v) $a)))
((rrule zzf mulmFL) (, (ssub (mul $u $v)) (s $u $a) (ctor $a flt) (mn $a M) (s $v $b) (isexpr $b))
                    (, (s (mul $u $v) (neg $b))))
((rrule zzf mulmFR) (, (ssub (mul $u $v)) (s $u $a) (isexpr $a) (s $v $b) (ctor $b flt) (mn $b M))
                    (, (s (mul $u $v) (neg $a))))
((rrule zzf mulbL) (, (ssub (mul $u $v)) (s $u $a) (zn $a NZ) (on $a NO) (mn $a NM) (s $v $b) (isexpr $b))
                   (, (s (mul $u $v) (mul $a $b))))
((rrule zzf mulbR) (, (ssub (mul $u $v)) (s $u $a) (isexpr $a) (s $v $b) (zn $b NZ) (on $b NO) (mn $b NM))
                   (, (s (mul $u $v) (mul $b $a))))
((rrule zzf mulbE) (, (ssub (mul $u $v)) (s $u $a) (isexpr $a) (s $v $b) (isexpr $b))
                   (, (s (mul $u $v) (mul $a $b))))
((rrule zzf muluL) (, (ssub (mul $u $v)) (s $u UNDEFINED) (s $v $b) (val $b))
                   (, (s (mul $u $v) UNDEFINED)))
((rrule zzf muluR) (, (ssub (mul $u $v)) (s $v UNDEFINED) (s $u $a) (val $a))
                   (, (s (mul $u $v) UNDEFINED)))

; div: zero denominator is UNDEFINED (any numerator, including
;      UNDEFINED) | zero numerator | unit denominator | same-operand |
;      builds | contagion. No integer folding: exact division is not
;      closed over the integers.
((rrule zzf divz)  (, (ssub (div $u $v)) (s $v (num 0)) (s $u $a) (val $a))
                   (, (s (div $u $v) UNDEFINED)))
((rrule zzf divzF) (, (ssub (div $u $v)) (s $v $b) (ctor $b flt) (zn $b Z) (s $u $a) (val $a))
                    (, (s (div $u $v) UNDEFINED)))
((rrule zzf div0Fa) (, (ssub (div $u $v)) (s $u $a) (ctor $a flt) (zn $a Z) (s $v $b) (isexpr $b))
                     (, (s (div $u $v) (flt 0.0))))
((rrule zzf div0Fb) (, (ssub (div $u $v)) (s $u $a) (ctor $a flt) (zn $a Z) (s $v $b) (zn $b NZ))
                     (, (s (div $u $v) (flt 0.0))))
((rrule zzf div1F) (, (ssub (div $u $v)) (s $v $b) (ctor $b flt) (on $b O) (s $u $a) (def $a))
                    (, (s (div $u $v) $a)))
((rrule zzf div0a) (, (ssub (div $u $v)) (s $u (num 0)) (s $v $b) (isexpr $b))
                   (, (s (div $u $v) (num 0))))
((rrule zzf div0b) (, (ssub (div $u $v)) (s $u (num 0)) (s $v $b) (zn $b NZ))
                   (, (s (div $u $v) (num 0))))
((rrule zzf div1)  (, (ssub (div $u $v)) (s $v (num 1)) (s $u $a) (def $a))
                   (, (s (div $u $v) $a)))
((rrule zzf divxE) (, (ssub (div $u $v)) (s $u $x) (s $v $x) (isexpr $x))
                   (, (s (div $u $v) (num 1))))
((rrule zzf divxN) (, (ssub (div $u $v)) (s $u $x) (s $v $x) (zn $x NZ))
                   (, (s (div $u $v) (num 1))))
((rrule zzf divbNN) (, (ssub (div $u $v)) (s $u $a) (zn $a NZ) (s $v $b) (zn $b NZ) (on $b NO) (vne $a $b))
                    (, (s (div $u $v) (div $a $b))))
((rrule zzf divbNE) (, (ssub (div $u $v)) (s $u $a) (zn $a NZ) (s $v $b) (isexpr $b))
                    (, (s (div $u $v) (div $a $b))))
((rrule zzf divbEN) (, (ssub (div $u $v)) (s $u $a) (isexpr $a) (s $v $b) (zn $b NZ) (on $b NO))
                    (, (s (div $u $v) (div $a $b))))
((rrule zzf divbEE) (, (ssub (div $u $v)) (s $u $a) (isexpr $a) (s $v $b) (isexpr $b) (vne $a $b))
                    (, (s (div $u $v) (div $a $b))))
((rrule zzf divuL) (, (ssub (div $u $v)) (s $u UNDEFINED) (s $v $b) (val $b))
                   (, (s (div $u $v) UNDEFINED)))
((rrule zzf divuR) (, (ssub (div $u $v)) (s $v UNDEFINED) (s $u $a) (val $a))
                   (, (s (div $u $v) UNDEFINED)))

; pow: exponent 1 | exponent 0 | build (exponent outside {0,1}) |
;      contagion. The exponent was decomposed, so its (num n) carries
;      zn/on facts.
((rrule zzf pow1F) (, (ssub (pow $u (flt $n))) (on (flt $n) O) (s $u $a) (def $a))
                   (, (s (pow $u (flt $n)) $a)))
((rrule zzf pow0F) (, (ssub (pow $u (flt $n))) (zn (flt $n) Z) (s $u $a) (def $a))
                   (, (s (pow $u (flt $n)) (num 1))))
((rrule zzf powbF) (, (ssub (pow $u (flt $n))) (s $u $a) (def $a) (zn (flt $n) NZ) (on (flt $n) NO))
                   (, (s (pow $u (flt $n)) (pow $a (flt $n)))))
((rrule zzf powuF) (, (ssub (pow $u (flt $n))) (s $u UNDEFINED))
                   (, (s (pow $u (flt $n)) UNDEFINED)))
((rrule zzf pow1) (, (ssub (pow $u (num 1))) (s $u $a) (def $a))
                  (, (s (pow $u (num 1)) $a)))
((rrule zzf pow0) (, (ssub (pow $u (num 0))) (s $u $a) (def $a))
                  (, (s (pow $u (num 0)) (num 1))))
((rrule zzf powb) (, (ssub (pow $u (num $n))) (s $u $a) (def $a) (zn (num $n) NZ) (on (num $n) NO))
                  (, (s (pow $u (num $n)) (pow $a (num $n)))))
((rrule zzf powu) (, (ssub (pow $u (num $n))) (s $u UNDEFINED))
                  (, (s (pow $u (num $n)) UNDEFINED)))

; neg: (num n) folds to (num -n) | double negation cancels | any other
;      constructor builds (negtag = every tag but num and neg) |
;      contagion
((rrule zzf negF) (, (ssub (neg $u)) (s $u (flt $a)))
                  (O (pure (s (neg $u) (flt $r)) $r
                           (f64_to_string (sub_f64 (f64_from_string 0.0) (f64_from_string $a))))))
((rrule zzf negf) (, (ssub (neg $u)) (s $u (num $a)))
                  (O (pure (s (neg $u) (num $r)) $r
                           (i64_to_string (sub_i64 (i64_from_string 0) (i64_from_string $a))))))
((rrule zzf negn) (, (ssub (neg $u)) (s $u (neg $x)))
                  (, (s (neg $u) $x)))
((rrule zzf negb) (, (ssub (neg $u)) (s $u $a) (ctor $a $c) (negtag $c))
                  (, (s (neg $u) (neg $a))))
((rrule zzf negu) (, (ssub (neg $u)) (s $u UNDEFINED))
                  (, (s (neg $u) UNDEFINED)))

; sin/cos/exp/ln: no identities — build over any defined value |
;      contagion
((rrule zzf sinb) (, (ssub (sin $u)) (s $u $a) (def $a)) (, (s (sin $u) (sin $a))))
((rrule zzf sinu) (, (ssub (sin $u)) (s $u UNDEFINED)) (, (s (sin $u) UNDEFINED)))
((rrule zzf cosb) (, (ssub (cos $u)) (s $u $a) (def $a)) (, (s (cos $u) (cos $a))))
((rrule zzf cosu) (, (ssub (cos $u)) (s $u UNDEFINED)) (, (s (cos $u) UNDEFINED)))
((rrule zzf expb) (, (ssub (exp $u)) (s $u $a) (def $a)) (, (s (exp $u) (exp $a))))
((rrule zzf expu) (, (ssub (exp $u)) (s $u UNDEFINED)) (, (s (exp $u) UNDEFINED)))
((rrule zzf expfb) (, (ssub (exp $u (flt $n))) (s $u $a) (def $a) (s (flt $n) (flt $n)))
                    (, (s (exp $u (flt $n)) (exp $a (flt $n)))))
((rrule zzf expfu) (, (ssub (exp $u (flt $n))) (s $u UNDEFINED) (s (flt $n) (flt $n)))
                    (, (s (exp $u (flt $n)) UNDEFINED)))
((rrule zzf expnb) (, (ssub (exp $u (num $n))) (s $u $a) (def $a) (s (num $n) (num $n)))
                    (, (s (exp $u (num $n)) (exp $a (num $n)))))
((rrule zzf expnu) (, (ssub (exp $u (num $n))) (s $u UNDEFINED) (s (num $n) (num $n)))
                    (, (s (exp $u (num $n)) UNDEFINED)))
((rrule zzf lnb)  (, (ssub (ln $u)) (s $u $a) (def $a)) (, (s (ln $u) (ln $a))))
((rrule zzf lnu)  (, (ssub (ln $u)) (s $u UNDEFINED)) (, (s (ln $u) UNDEFINED)))

; ---------------------------------------------------------------------
; Sweep driver: one classify+construct sweep per recorded slevel
; ---------------------------------------------------------------------
(exec (zzi Z)
  (, (exec (zzi $l) $p $t)
     (slevel $l)
     ((rrule $g $k) $rp $rt))
  (, (exec ($g ($l $k)) $rp $rt)
     (exec (zzi (S $l)) $p $t)))

; ---------------------------------------------------------------------
; Replace results (staged, so an already-simple D survives)
; ---------------------------------------------------------------------
(exec (zzo a) (, (result $e $de) (s $de $sd)) (, (final $e $sd)))
(exec (zzo b) (, (result $e $de)) (O (- (result $e $de))))
(exec (zzo c) (, (final $e $sd)) (, (result $e $sd)))
