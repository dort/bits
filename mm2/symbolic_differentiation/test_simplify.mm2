; Tests for SIMPLIFIED differentiation results. Two ways to run:
;   post-process:  ./run.sh test_simplify.mm2 simplify.mm2
;   fused engine:  ENGINE=diff_engine_fused.mm2 ./run.sh test_simplify.mm2
;
; Both implementations must produce identical results on these cases:
; the inputs contain no redundancy of their own, so the one semantic
; difference between them (the post-process pass also simplifies inside
; copied input subterms, the fused engine keeps them verbatim) does not
; show here.
;
; Expected output: one (CORRECT EXPR) per case and no MISTAKE facts.

; ---------------- test inputs ----------------
(diff (var x))
(solution (var x) (num 1))

(diff (num 7))
(solution (num 7) (num 0))

(diff (add (mul (var x) (var x)) (mul (num 2) (var x))))
(solution (add (mul (var x) (var x)) (mul (num 2) (var x)))
          (add (add (var x) (var x)) (num 2)))

(diff (sin (mul (var x) (var x))))
(solution (sin (mul (var x) (var x)))
          (mul (cos (mul (var x) (var x))) (add (var x) (var x))))

(diff (div (var x) (add (var x) (cst a))))
(solution (div (var x) (add (var x) (cst a)))
          (div (sub (add (var x) (cst a)) (var x))
               (mul (add (var x) (cst a)) (add (var x) (cst a)))))

(diff (mul (exp (neg (var x))) (ln (var x))))
(solution (mul (exp (neg (var x))) (ln (var x)))
          (add (mul (neg (exp (neg (var x)))) (ln (var x)))
               (mul (exp (neg (var x))) (div (num 1) (var x)))))

(diff (cos (sub (var x) (num 2))))
(solution (cos (sub (var x) (num 2)))
          (neg (sin (sub (var x) (num 2)))))

; chains the minus-one collapse (mul e (num -1)) -> (neg e) — the neg
; fold turns (neg (num 1)) into (num -1) first — then double negation
(diff (cos (neg (var x))))
(solution (cos (neg (var x))) (sin (neg (var x))))

(diff (pow (var x) (num 3)))
(solution (pow (var x) (num 3)) (mul (num 3) (pow (var x) (num 2))))

(diff (pow (add (var x) (cst a)) (num -2)))
(solution (pow (add (var x) (cst a)) (num -2))
          (mul (num -2) (pow (add (var x) (cst a)) (num -3))))

; numerator (sub e e) -> (num 0), then zero numerator; d(x/x) = 0
(diff (div (var x) (var x)))
(solution (div (var x) (var x)) (num 0))

; (div e e) -> (num 1) on the ln rule's quotient; ln(exp x) = x, d = 1
(diff (ln (exp (var x))))
(solution (ln (exp (var x))) (num 1))

; the quotient rule's denominator folds to (num 0): division by zero is
; UNDEFINED
(diff (div (var x) (num 0)))
(solution (div (var x) (num 0)) UNDEFINED)

; UNDEFINED is contagious through the enclosing sum
(diff (add (var x) (div (var x) (num 0))))
(solution (add (var x) (div (var x) (num 0))) UNDEFINED)

; ---------------- test code ----------------
(exec (zzt 0) (, (diff $e) (result $e $de)) (O (+ (MISTAKE $e $de))))
(exec (zzt 0) (, (diff $e) (solution $e $de)) (O (+ (MISTAKE $e $de))))
(exec (zzt 1) (, (result $e $de) (solution $e $de)) (O (- (MISTAKE $e $de))))
(exec (zzt 2) (, (diff $e)) (, (CORRECT $e)))
(exec (zzt 3) (, (MISTAKE $e $de)) (O (- (CORRECT $e))))
