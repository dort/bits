; (converted_op (builtin ge_i64 (cons (v n) (cons (c 2) nil))))
(exec 10 (, (convert_op $op)
           (listify $op (cons $builtin_or_atom (cons $builtin_or_atom_name $rest)) )
        )
        (, (converted_op ($builtin_or_atom $builtin_or_atom_name $rest)))
)
